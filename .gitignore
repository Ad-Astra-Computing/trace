# Rust build artifacts
graph/target/

# Python caches
__pycache__/
*.pyc
.pytest_cache/

# Local venvs / tooling
.venv/
.venv-*/

# Local experiment artifacts, API keys, ad hoc run outputs, scratch
# scoring dumps — these never belong in git. Add patterns here as the
# model-facing work starts producing run artifacts.
.env
.env.*
*.env
/scratch/
/scratch-*/
/eval-runs/

# Scout inbox — local cron writes one dir per CVE; replay-critical bytes
# but not source-controlled artifacts.
/inbox/

# Model-role parse-failure capture (F19, 2026-05-25). Written under each
# bundle dir when the model output fails the parser contract; carries
# raw-response.txt + failure.json for debugging. Not part of the signed
# replay manifest; not source-controlled.
**/.patcher-failures/
**/.reviewer-failures/
**/.reproducer-failures/

# Claude Code session state (auto-memory, settings)
.claude/

# generated training-data exports (regenerated by `trace export`)
exports/

# local bundle-bootstrap scratch staging (never part of the corpus)
/tmp/
