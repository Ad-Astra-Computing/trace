{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trace.adastra.computer/schemas/finding-schema.json",
  "title": "trace finding",
  "description": "Scout output at <bundle-dir>/finding.json. One CVE matched against one or more nixpkgs derivations, with an explicit CPE/PURL mapping confidence score. Low-confidence findings MUST NOT auto-advance to Patcher; they divert to the mapping-failures queue and ship as advisory-only.",
  "type": "object",
  "required": [
    "schema_version",
    "cve_id",
    "source_feeds",
    "severity",
    "published_at",
    "affected",
    "mapping",
    "replay_critical"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "cve_id": { "type": "string", "pattern": "^CVE-\\d{4}-\\d{4,19}$" },
    "source_feeds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["nvd", "ghsa", "osv"] }
    },
    "severity": {
      "type": "object",
      "required": ["rating", "cvss_v3_score"],
      "additionalProperties": false,
      "properties": {
        "rating": {
          "type": "string",
          "enum": ["critical", "high", "medium", "low", "none", "unknown"]
        },
        "cvss_v3_score": {
          "oneOf": [
            { "type": "number", "minimum": 0, "maximum": 10 },
            { "type": "null" }
          ]
        },
        "cvss_v3_vector": { "type": "string" }
      }
    },
    "published_at": { "type": "string", "format": "date-time" },
    "summary": { "type": "string", "maxLength": 2000 },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "kind"],
        "additionalProperties": false,
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "kind": {
            "type": "string",
            "enum": ["advisory", "upstream-commit", "release-notes", "blog", "bug-tracker", "other"]
          }
        }
      }
    },
    "affected": {
      "description": "Derivations in the pinned nixpkgs rev that this CVE is believed to affect. At least one entry required. Each carries its own confidence so multi-match findings can be partially ineligible.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["attr_path", "drv_path", "pname", "version", "confidence"],
        "additionalProperties": false,
        "properties": {
          "attr_path": { "type": "string", "minLength": 1 },
          "drv_path": { "type": "string", "pattern": "^/nix/store/[a-z0-9]{32}-.+\\.drv$" },
          "pname": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "src_url": { "type": "string", "format": "uri" },
          "src_hash": { "type": "string" },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "confidence_reason": {
            "description": "Why this confidence level. Required when confidence != high.",
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": { "properties": { "confidence": { "not": { "const": "high" } } } },
            "then": { "required": ["confidence_reason"] }
          }
        ]
      }
    },
    "mapping": {
      "description": "CPE/PURL identifiers used for the match. Presence of both is ideal but not required; the resolver prefers purl when available.",
      "type": "object",
      "required": ["method"],
      "additionalProperties": false,
      "properties": {
        "cpe": {
          "type": "array",
          "items": { "type": "string", "pattern": "^cpe:2\\.3:" }
        },
        "purl": {
          "type": "array",
          "items": { "type": "string", "pattern": "^pkg:" }
        },
        "method": {
          "type": "string",
          "enum": ["cpe-exact", "purl-exact", "pname-heuristic", "maintainer-reported"]
        },
        "mapping_notes": { "type": "string" }
      }
    },
    "replay_critical": { "type": "boolean", "const": true }
  }
}
