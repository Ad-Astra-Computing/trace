{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trace.adastra.computer/schemas/bundle-schema.json",
  "title": "trace bundle manifest",
  "description": "Top-level manifest at <bundle-dir>/bundle.json. Enumerates every artifact in the bundle with a content hash, declares the bundle kind (auto-merge | advisory-only | human-review-required), and lists which file hashes are covered by the Steward signature. Steward validates this document, then verifies every referenced file exists and hashes to the declared value, then validates referenced sub-documents against their own schemas.",
  "type": "object",
  "required": [
    "schema_version",
    "bundle_id",
    "cve_id",
    "nixpkgs_rev",
    "kind",
    "created_at",
    "policy_version",
    "files",
    "signed_manifest"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "description": "Bundle manifest schema version. 1.0.0 is the original locked shape. 1.1.0 adds the optional source-context manifest for source-backport bundles (semantic-backport-adaptation arc); a 1.1.0 source-backport MUST carry source_context, a 1.1.0 non-source-backport MUST NOT (see allOf). 1.0.0 bundles forbid both new fields, so every previously-signed bundle stays valid.",
      "type": "string",
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "patch_strategy": {
      "description": "Resolver-authorized patch strategy, copied verbatim from upstream-ref.json eligibility.patch_strategy at finalize (Steward rejects any disagreement between the two). Present only on 1.1.0 bundles. 'source-backport' means the Patcher authored an in-tree patch against the pinned version and MUST have carried source_context.",
      "type": "string",
      "enum": [
        "version-bump",
        "source-backport"
      ]
    },
    "source_context": {
      "description": "Sorted manifest of the pre-patch source files (under source-context/) the Patcher (v4) saw so it could author a semantic adaptation when the upstream fix does not apply verbatim to the pinned base. Each entry's sha256 MUST equal files[path].sha256, each path MUST also appear in files (producer_role source-context-extractor, replay_critical true) and in signed_manifest.signed_files, and there MUST be no source-context/ file on disk absent from this manifest. Present only on 1.1.0 source-backport bundles.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^source-context/.+"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "bundle_id": {
      "description": "Stable bundle identifier. sha256 of (cve_id || nixpkgs_rev || created_at) hex-encoded, first 16 chars.",
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "cve_id": {
      "type": "string",
      "pattern": "^CVE-\\d{4}-\\d{4,19}$"
    },
    "nixpkgs_rev": {
      "description": "Commit hash of the trace nixpkgs fork at the time this bundle was produced.",
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "kind": {
      "description": "Bundle disposition. Determines which files are required and whether Steward may auto-merge.",
      "type": "string",
      "enum": [
        "auto-merge",
        "advisory-only",
        "human-review-required"
      ]
    },
    "kind_reason": {
      "description": "Machine-readable reason for non-auto-merge kinds. Required unless kind == auto-merge.",
      "type": "string",
      "enum": [
        "ineligible-no-fix-available",
        "ineligible-major-version-only",
        "ineligible-cherry-pick-required",
        "ineligible-low-confidence-mapping",
        "ineligible-no-passthru-tests",
        "ineligible-no-vuln-reproducer",
        "sandbox-poc-requires-network",
        "poc-construction-exceeds-anchor-depth",
        "poc-needs-validation-bypass-fixture",
        "shipped-binary-non-discrimination",
        "blast-radius-exceeds-threshold",
        "major-version-jump-requires-review",
        "ambiguous-changelog-requires-review",
        "large-sbom-delta",
        "reviewer-verdict-escalate",
        "cross-family-pair-unavailable",
        "source-backport-experimental",
        "unparseable-version-comparison"
      ]
    },
    "auto_merge_evidence_path": {
      "description": "Which cross-family witness (per SPEC \u00a75) carries the auto-merge evidence for this bundle. 'reproducer' (default): Builder ran the bundle's reproducer.nix and Steward gates on repro-unpatched-fails / repro-patched-passes scorers (rules 7, 9, 10). 'reviewer-attested': bundle has no usable Reproducer (silent crash class, sandbox-incompatible, etc.); the cross-family witness is the Reviewer, and the bundle MUST ship reproducer-refusal.json (machine-readable justification of why no Reproducer is feasible) and review-scoring-report.json with verdict=accept (Steward rule 13). Only consulted when kind=auto-merge; ignored otherwise.",
      "type": "string",
      "enum": [
        "reproducer",
        "reviewer-attested"
      ],
      "default": "reproducer"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "policy_version": {
      "description": "sha256 of policy/steward.rego at time of bundle creation.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bundle_schema_version": {
      "description": "sha256 of this schema file at time of bundle creation. Present in addition to schema_version so Steward can detect schema drift even when the const version tag is unchanged.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "files": {
      "description": "Every file in the bundle directory, with sha256. Keys are POSIX-style relative paths. Which keys are required depends on kind (see allOf).",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "sha256",
          "bytes",
          "producer_role",
          "replay_critical"
        ],
        "additionalProperties": false,
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "producer_role": {
            "type": "string",
            "enum": [
              "scout",
              "cartographer",
              "upstream-ref-resolver",
              "source-context-extractor",
              "patcher",
              "reproducer",
              "builder",
              "reviewer",
              "steward"
            ]
          },
          "replay_critical": {
            "description": "If true, this file's exact content is required to reproduce the bundle. Steward refuses replay comparisons where a replay_critical file's hash differs. If false, the file is informational (build logs, human notes).",
            "type": "boolean"
          }
        }
      }
    },
    "signed_manifest": {
      "description": "The subset of files covered by bundle.sig. Steward MUST only sign bundles where every replay_critical file is listed here. bundle.sig itself and provenance.jsonl MUST NOT appear (signature cannot cover itself; provenance is append-only and signed separately by Scout-issued action records). For sigstore-cosign-v1 (the v0-locked path per docs/SIGNING_V1.md), identity_subject + identity_issuer + rekor_log_index + rekor_uuid are optional but recommended; verifiers read the locked identity-policy regex from policy/signing-identity.json.",
      "type": "object",
      "required": [
        "algorithm",
        "signed_files",
        "signer"
      ],
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "sigstore-cosign-v1",
            "minisign-ed25519"
          ]
        },
        "signer": {
          "description": "Identity that produced bundle.sig. For sigstore-cosign-v1, the OIDC subject string (e.g. 'https://github.com/Ad-Astra-Computing/trace/.github/workflows/steward.yml@refs/heads/main'). For minisign, the public key id.",
          "type": "string",
          "minLength": 1
        },
        "identity_subject": {
          "description": "OIDC subject claim presented at signing time. Carried forward from the cosign signing flow so verifiers can cross-check against policy/signing-identity.json without re-deriving from bundle.sig. Optional but recommended for sigstore-cosign-v1.",
          "type": "string",
          "minLength": 1
        },
        "identity_issuer": {
          "description": "OIDC issuer URL the subject was issued by. For GitHub Actions signing this is 'https://token.actions.githubusercontent.com'. Optional; verifiers fall back to policy/signing-identity.json when absent.",
          "type": "string",
          "format": "uri"
        },
        "rekor_log_index": {
          "description": "Rekor public-transparency-log entry index returned by `cosign sign-blob`. The durable proof of when this bundle was signed. Optional in v0 because not every signing path produces it; sigstore-cosign-v1 always does.",
          "type": "integer",
          "minimum": 0
        },
        "rekor_uuid": {
          "description": "Rekor log entry UUID returned by `cosign sign-blob`. Stable identifier for the entry; pairs with rekor_log_index for retrieval. Optional in v0.",
          "type": "string",
          "pattern": "^[0-9a-f]+$",
          "minLength": 32
        },
        "signed_files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "$comment": "1.0.0 bundles predate the source-context contract: forbid both new fields so every previously-signed bundle validates unchanged and nothing can smuggle an unsigned source-context claim into a 1.0.0 manifest.",
      "if": {
        "required": [
          "schema_version"
        ],
        "properties": {
          "schema_version": {
            "const": "1.0.0"
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "patch_strategy"
              ]
            },
            {
              "required": [
                "source_context"
              ]
            }
          ]
        }
      }
    },
    {
      "$comment": "1.1.0: a source-backport MUST carry source_context; any other strategy MUST NOT. This is why patch_strategy lives in the manifest — presence of source_context alone could not enforce the source-backport requirement.",
      "if": {
        "required": [
          "schema_version"
        ],
        "properties": {
          "schema_version": {
            "const": "1.1.0"
          }
        }
      },
      "then": {
        "required": [
          "patch_strategy"
        ],
        "if": {
          "properties": {
            "patch_strategy": {
              "const": "source-backport"
            }
          }
        },
        "then": {
          "required": [
            "source_context"
          ]
        },
        "else": {
          "not": {
            "required": [
              "source_context"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "auto-merge"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "kind_reason"
          ]
        },
        "allOf": [
          {
            "if": {
              "required": [
                "auto_merge_evidence_path"
              ],
              "properties": {
                "auto_merge_evidence_path": {
                  "const": "reviewer-attested"
                }
              }
            },
            "then": {
              "properties": {
                "files": {
                  "required": [
                    "bundle.json",
                    "finding.json",
                    "impact.json",
                    "maintainers.json",
                    "upstream-ref.json",
                    "patch.diff",
                    "patch-rationale.md",
                    "passthru-tests.json",
                    "build.json",
                    "sbom-delta.json",
                    "replay.json",
                    "provenance.jsonl",
                    "bundle.sig",
                    "review.md"
                  ],
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "reproducer.nix"
                        ]
                      },
                      {
                        "required": [
                          "reproducer-log.txt"
                        ]
                      },
                      {
                        "required": [
                          "review-refusal.json"
                        ]
                      }
                    ]
                  }
                }
              }
            },
            "else": {
              "properties": {
                "files": {
                  "required": [
                    "bundle.json",
                    "finding.json",
                    "impact.json",
                    "maintainers.json",
                    "upstream-ref.json",
                    "patch.diff",
                    "patch-rationale.md",
                    "passthru-tests.json",
                    "reproducer.nix",
                    "reproducer-log.txt",
                    "build.json",
                    "sbom-delta.json",
                    "replay.json",
                    "provenance.jsonl",
                    "bundle.sig"
                  ],
                  "anyOf": [
                    {
                      "required": [
                        "review.md"
                      ]
                    },
                    {
                      "required": [
                        "review-refusal.json"
                      ]
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "advisory-only"
          }
        }
      },
      "then": {
        "required": [
          "kind_reason"
        ],
        "properties": {
          "files": {
            "required": [
              "bundle.json",
              "finding.json",
              "impact.json",
              "maintainers.json",
              "upstream-ref.json",
              "replay.json",
              "provenance.jsonl",
              "bundle.sig"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "patch.diff"
                  ]
                },
                {
                  "required": [
                    "patch-rationale.md"
                  ]
                },
                {
                  "required": [
                    "reproducer.nix"
                  ]
                },
                {
                  "required": [
                    "reproducer-log.txt"
                  ]
                },
                {
                  "required": [
                    "passthru-tests.json"
                  ]
                },
                {
                  "required": [
                    "build.json"
                  ]
                },
                {
                  "required": [
                    "review.md"
                  ]
                },
                {
                  "required": [
                    "review-refusal.json"
                  ]
                },
                {
                  "required": [
                    "sbom-delta.json"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "human-review-required"
          }
        }
      },
      "then": {
        "required": [
          "kind_reason"
        ],
        "allOf": [
          {
            "if": {
              "required": [
                "auto_merge_evidence_path"
              ],
              "properties": {
                "auto_merge_evidence_path": {
                  "const": "reviewer-attested"
                }
              }
            },
            "then": {
              "properties": {
                "files": {
                  "required": [
                    "bundle.json",
                    "finding.json",
                    "impact.json",
                    "maintainers.json",
                    "upstream-ref.json",
                    "patch.diff",
                    "patch-rationale.md",
                    "passthru-tests.json",
                    "build.json",
                    "sbom-delta.json",
                    "replay.json",
                    "provenance.jsonl",
                    "bundle.sig",
                    "review.md"
                  ],
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "reproducer.nix"
                        ]
                      },
                      {
                        "required": [
                          "reproducer-log.txt"
                        ]
                      }
                    ]
                  }
                }
              }
            },
            "else": {
              "properties": {
                "files": {
                  "required": [
                    "bundle.json",
                    "finding.json",
                    "impact.json",
                    "maintainers.json",
                    "upstream-ref.json",
                    "patch.diff",
                    "patch-rationale.md",
                    "passthru-tests.json",
                    "reproducer.nix",
                    "reproducer-log.txt",
                    "build.json",
                    "sbom-delta.json",
                    "replay.json",
                    "provenance.jsonl",
                    "bundle.sig"
                  ],
                  "anyOf": [
                    {
                      "required": [
                        "review.md"
                      ]
                    },
                    {
                      "required": [
                        "review-refusal.json"
                      ]
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    }
  ]
}
