diff --git a/CVE-2026-15028.patch b/CVE-2026-15028.patch
new file mode 100644
--- /dev/null
+++ b/CVE-2026-15028.patch
@@ -0,0 +1,32 @@
+Backport of CVE-2026-15028: fix 1-byte OOB read in tar_atol_base_n().
+
+Upstream fix: libarchive/libarchive@c16162083a247efd4a2bc71401489bec3090ae7c
+(PR #3253, commit f93abd161ec37326c566f4f0efcd44fe7a66dd95).
+
+The upstream fix uses archive_ckd_mul_i64/archive_ckd_add_i64 helpers
+that do not exist in libarchive 3.8.7. This adaptation reproduces the
+same security-relevant behavior — reading each digit only while bytes
+remain — using the pinned base's own overflow-check idiom (l > limit
+or l == limit && digit >= last_digit_limit) already present in
+tar_atol_base_n().
+
+diff --git a/libarchive/archive_read_support_format_tar.c b/libarchive/archive_read_support_format_tar.c
+--- a/libarchive/archive_read_support_format_tar.c
++++ b/libarchive/archive_read_support_format_tar.c
+@@ -3517,13 +3517,13 @@ tar_atol_base_n(const char *p, size_t char_cnt, int base)
+ 	}
+ 
+ 	l = 0;
+-	if (char_cnt != 0) {
++	while (char_cnt != 0) {
+ 		digit = *p - '0';
+-		while (digit >= 0 && digit < base  && char_cnt != 0) {
+-			if (l>limit || (l == limit && digit >= last_digit_limit)) {
+-				return maxval; /* Truncate on overflow. */
+-			}
+-			l = (l * base) + digit;
+-			digit = *++p - '0';
+-			char_cnt--;
++		if (digit < 0 || digit >= base)
++			break;
++		if (l > limit || (l == limit && digit >= last_digit_limit)) {
++			return maxval; /* Truncate on overflow. */
+ 		}
++		l = archive_ckd_add_i64(archive_ckd_mul_i64(l, base), digit);
++		p++;
++		char_cnt--;
+ 	}
+ 	return (sign < 0) ? -l : l;
+ }
